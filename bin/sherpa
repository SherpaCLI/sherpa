#
# Old stuff
# ...will be removed.
#
modify_value() {
	local key="$1"
	local new_value="$2"
	local filename="$3"

	# Use sed to find the key and modify its value
	sed_inplace "$filename" -E "s/^(${key}[[:space:]]*=[[:space:]]*).*/\1${new_value}/"
}
#!/usr/bin/env bash

# All about files and folders manipulation

hello_link() {
  echo
  echo "Hello from tent/symlink.sh"
  echo
}

#
# --- Symlinks ---
#

_is_command() {

  local link_name=$1

  # Check if the name is already a command
  if command -v "$link_name" &> /dev/null; then
      echo "Error: A command with the name '$link_name' already exists."
      exit 1
  fi
}

_sl_exists() {

  local target_dir=$1
  local link_name=$2

  # Check if a symlink already exists
  if [ -L "$target_dir/$link_name" ]; then
      echo "Error: A symlink named '$link_name' already exists in $target_dir."
      exit 1
  fi

}

_sl_create() {

  file_path=$1
  target_dir=$2
  link_name=$3

  # Create the symlink
  ln -s "$file_path" "$target_dir/$link_name"
}

# --- End Symlinks Helpers ------------------

symlink_add() {

  local file_path=$1
  local target_dir=$2
  local link_name=$3
  local link=${target_dir}/${link_name}

  # Check if the name is already a command
  #_is_command "$link_name"

  # Check if a symlink already exists
  _sl_exists "$target_dir" "$link_name"

  # Create the symlink
  _sl_create "$file_path" "$target_dir" "$link_name"

  if [[ $? == 0 ]]; then
      p "Symlink created successfully."
  else
      p "Error creating symlink."
      exit 1
  fi
}

symlink_remove() {

  # TODO: Check if it exists, confirm, etc

  link=$1

  rm -i $link
  [[ ! -L $link ]] && echo "'cause now I'm freeeee"
}

symlinks_list() {
    local dir="${1:-$HOME/.sherpa/bin}"

    while IFS= read -r -d '' file; do
        if [ -L "$file" ]; then
            echo "$(basename "$file") -> $(readlink -f "$file")"
        fi
    done < <(find "$dir" -type l -print0)
}

# @file Router
# @brief The single dispatch table: command word -> cmd_* function
# @description
#
#	Every command lives in src/commands/<name>.sh and exposes a
#	cmd_<name>() function. This router is the only place that maps a
#	command word (or its alias) to that function, so:
#
#	  * the command list has one source of truth (see sherpa_commands)
#	  * a typo is reported instead of silently doing nothing
#	  * two files can no longer shadow each other's command
#	  * each command gets a clean OPTIND, so its own flags parse
#
#	Concatenated before src/help/options.sh, so the help screen can
#	read the same table. The entry point that calls sherpa_main lives
#	in src/main.sh, concatenated last.
#
#	The cmd_* functions receive the command word as $1, exactly like
#	the old straight-line `if [[ "$1" == "cmd" ]]` blocks did. That
#	keeps each function's body untouched and makes aliases work.
#
#  Usage: (internal - see `sherpa help`)
#

# The command table: word|aliases|description
# Consumed by the router, the help screen and `sherpa list`.
sherpa_commands() {
	cat <<'COMMAND_TABLE'
home||The dashboard
help|h|Show the usage message
version|v|Show the Sh:erpa version
new||Scaffold a new BashBox or Lib
init||Scaffold a BashBox in the current directory
build|b|Combine the partials, generate the docs, link the executable
run|r|Build the package and run it
watch|w|Rebuild on every save in src/ and data/
doc|d|Generate the documentation only
test|t|Run the tests with BashUnit
compile||Compile the built script to a binary with SHC
edit|e|Open a key file in $EDITOR
links||List the symlinks in the bin directory
list|ls,boxes|List the local BashBoxes and Libs, as text or --json
localBox||Show the details of one local BashBox
rmBox||Remove a local BashBox
rmLib||Remove a local Lib
upBox||Update an installed BashBox
upLib||Update an installed Lib
install||Install a BashBox or Lib from a git repository
uninstall||Uninstall an installed BashBox or Lib
update||Update an installed BashBox or Lib
aliases||Edit the Aliases
self-update||Update Sh:erpa itself
self-test||Run Sh:erpa's own test suite
COMMAND_TABLE
}

# Print the version from the manifest, tolerating the old flat schema.
cmd_version() {
	local version
	version="$(get_yaml_item "package.version" "${SDD}/Sherpa.yaml" 2>/dev/null || true)"
	if [[ "$version" == "null" || -z "$version" ]]; then
		version="$(get_yaml_item "version" "${SDD}/Sherpa.yaml" 2>/dev/null || true)"
	fi
	printf "%s v%s\n" "Sh:erpa" "${version}"
}

sherpa_main() {
	local cmd="${1:-}"

	# Every command may touch the custom dir: make sure it is there
	ensure_scd

	case "$cmd" in
	"" | home) cmd_home "$@" ;;
	help | h) usage ;;
	version | v) cmd_version ;;
	new) cmd_new "$@" ;;
	init) cmd_init "$@" ;;
	build | b) cmd_build "$@" ;;
	run | r) cmd_run "$@" ;;
	watch | w) cmd_watch "$@" ;;
	doc | d) cmd_doc "$@" ;;
	test | t) cmd_test "$@" ;;
	compile) cmd_compile "$@" ;;
	edit | e) cmd_edit "$@" ;;
	links) cmd_links "$@" ;;
	list | ls | boxes) cmd_list "$@" ;;
	localBox | rmBox | rmLib | upLib) cmd_box "$@" ;;
	upBox) cmd_upBox "$@" ;;
	aliases) cmd_aliases ;;
	install) cmd_install "$@" ;;
	uninstall) cmd_uninstall "$@" ;;
	update) cmd_update "$@" ;;
	self-update | self-test) cmd_self_update "$@" ;;
	*)
		br
		p "${btnWarning} Oops! ${x} Unknown command: ${em}${cmd}${x}"
		p "Try ${em}sherpa help${x} for the list of commands."
		br
		exit 1
		;;
	esac
}
# ------------------------------- #
#   Options -flags with GetOpts   #
# ------------------------------- #

# @file Flags with GetOpts
#
# @description --- The Options file: src/help/options.sh ---
#
#	Parses the global flags, then shifts them away so $@ holds the
#	command word and its arguments. The command table itself lives in
#	src/router.sh and is the only place a command is declared.
#
#	To print text that will be ignored by -q || --quiet
#	or something only printed if -v || --verbose
#	[[ "$quiet" != "on" ]] && p "Normal log."
#	[[ "$verb" == "on" ]] && p "Verbose log."
#

# Declaring variables from std/src used in this file.
declare -g strong
declare -g txtBlue
declare -g txtGreen
declare -g x

# Flag defaults, overridden by the getopts loop below.
# Declared here rather than in a command, so a command can never
# reset them after the flags were parsed.
verb="off"
quiet="off"

# For the -c demo flag, assigning a value via myScript -c purple
color="" # String

# @description usage fn
# Printing the Help menu for -h, --help and `sherpa help`.
# The command list is read from the table in src/router.sh, so it
# can never fall out of sync with what is actually routable.
usage() {
	if [[ -t 1 ]]; then clear; fi

	h1 " Welcome, I'm your Sh:erpa 👋"
	hr "sh:help" "-"
	br
	p "${strong}${txtBlue}Usage:${x} ${txtGreen}sherpa [options] <command> [arg]${x}"
	br
	p "${strong}${txtBlue}Options:${x}"
	p "  -h | --help       Display the usage message"
	p "  -v | --version    Display the version"
	p "  -V | --verbose    Enable the verbose mode"
	p "  -q | --quiet      Continue force execution"
	br
	p "${strong}${txtBlue}Commands:${x}"

	local word aliases description
	while IFS='|' read -r word aliases description; do
		[[ -z "$word" ]] && continue
		p "  ${txtGreen}${word}${x}${aliases:+ (${aliases})} ${em}${description}${x}"
	done < <(sherpa_commands)

	br
	p "Docs & News: ${link}https://sherpa-cli.netlify.app${x}"
	p "Discord:     ${link}https://discord.gg/66bQJ6cuXG${x}"
	br
}

# Using getopts for portability, as it is a shell builtin instead of
# an external program like "getopt".
while getopts ":hvc:Vq-:" opt; do
	# Avoid placing an argument expecting option
	# before the "-:" mark, like ":hvVqc:-:"
	case $opt in
	h)
		usage
		exit 0
		;;
	v)
		cmd_version
		exit 0
		;;
	c)
		# Custom flag -c expecting a color name as argument.
		# Usage: sherpa -c purple
		color=${OPTARG}
		;;
	V)
		verb="on"
		;;
	q)
		quiet="on"
		;;
	-)
		case "${OPTARG}" in
		# --help
		help)
			usage
			exit 0
			;;
		# --version
		version)
			cmd_version
			exit 0
			;;
		# --verbose
		verbose)
			verb="on"
			;;
		# --quiet
		quiet)
			quiet="on"
			;;
		*)
			# Long flags Error handling
			echo "Unknown option --${OPTARG}" >&2
			exit 1
			;;
		esac
		;;
	\?)
		# Short flags Error handling
		echo "Invalid option: -$OPTARG" >&2
		exit 1
		;;
	:)
		# Missing required argument Error handling
		echo "Option -$OPTARG requires an argument." >&2
		exit 1
		;;
	esac
done

# Removing the global flags from the flow
shift $((OPTIND - 1))
OPTIND=1
# @file Home
# @brief The dashboard, displayed when Sh:erpa is called alone
# @description
#
#	To be used from anywhere.
#
#	It will:
#	  * Display a welcome screen with some evolving data
#	  * List the local and installed BashBoxes and Libs
#	  * Check for a new Sh:erpa at most once a day
#
#	The update check is cached, and it runs in a subshell: the old
#	version changed the caller's directory and hit the network on
#	every single invocation.
#
#  Usage: s, sherpa
#

# shellcheck disable=SC2034
# shellcheck disable=SC2154

# Direct sub-directory names of $1, one per line. Globbing rather
# than find, so this also works with BSD userland (macOS).
list_dirs() {
	local dir="$1"
	local entry

	[[ -d "$dir" ]] || return 0

	for entry in "$dir"/*/; do
		[[ -d "$entry" ]] || continue
		basename "$entry"
	done
}

# One dashboard section: directory + heading label.
dashboard_section() {
	local dir="$1"
	local label="$2"
	local with_exe="${3:-off}"

	local found="off" name exe

	h2 " ${label}"

	while IFS= read -r name; do
		found="on"
		if [[ "$with_exe" == "on" ]]; then
			exe="$(get_yaml_item "package.executable" "${dir}/${name}/Sherpa.yaml" 2>/dev/null || true)"
			[[ "$exe" == "null" ]] && exe=""
			p "* ${txtBlue}${name}${x}${exe:+: ${em}${exe}${x}}"
		else
			p "* ${txtBlue}${name}${x}"
		fi
	done < <(list_dirs "$dir")

	[[ "$found" == "off" ]] && p " ${btnWarning} Empty ${x} Nothing here yet."
	br
}

# Look for a newer Sh:erpa on the remote, at most once a day.
# Writes ${SDD}/.update-check as a timestamp, and appends
# .available when an update is actually waiting.
check_for_updates() {
	local cache="${SDD}/.update-check"
	local now last

	now="$(date +%s)"

	if [[ -f "$cache" ]]; then
		last="$(cat "$cache" 2>/dev/null || echo 0)"
		[[ "$last" =~ ^[0-9]+$ ]] || last=0
		((now - last < 86400)) && return 0
	fi

	printf "%s" "$now" >"$cache"

	# Subshell: never leaves the caller in another directory,
	# and a missing network is not an error.
	(
		cd "${SDD}" || exit 0
		git fetch origin -q 2>/dev/null || exit 0

		branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" || exit 0
		[[ "$branch" == "HEAD" ]] && exit 0

		ahead="$(git rev-list "HEAD..origin/${branch}" --count 2>/dev/null || echo 0)"
		[[ "$ahead" -gt 0 ]] && printf "yes" >"${cache}.available"
	)

	return 0
}

cmd_home() {
	# Bootstrap the custom directory from the template when missing
	ensure_scd

	if [[ -t 1 ]]; then clear; fi

	h1 " Welcome to the Basecamp 👋"
	hr "Sh:erpa" "-"
	text-center "$(date "+%b %d - %H:%M")"

	dashboard_section "${SCD}/boxes" "Local BashBoxes" "on"
	dashboard_section "${SCD}/bbr/bin" "Installed BashBoxes" "on"
	dashboard_section "${SCD}/lib" "Local Libraries"
	dashboard_section "${SCD}/bbr/lib" "Installed Libraries"

	h3 "Join us, the coffee is still warm."
	p "Docs: ${link}https://sherpa-cli.netlify.app${x}"
	p "Github: ${link}https://github.com/SherpaCLI${x}"
	p "Discord: ${link}https://discord.gg/66bQJ6cuXG${x}"
	br

	check_for_updates

	if [[ -f "${SDD}/.update-check.available" ]]; then
		p "${btnWarning}!${x} A new Sh:erpa is available: ${em}sherpa self-update${x}"
		br
	fi
}

cmd_aliases() {
	# Edit the aliases in the Aliasman file
	aliasman -e
}
# @file Bashdoc
# @brief Generating documentation with bashdoc.
# @description
#
#    To be used from the root of a Sherpa project,
#    created with "sherpa new myProject".
#
#    It will:
#      * Create the docs/ folder if necessary
#      * Use .sherpa/templates/bashdoc.hbs as template
#      * Loop trough the .sh files in the src/ folder
#      * Generates the files in the docs/ folder
#
#  Usage: sherpa bashdoc
#
# @see [shdoc](https://github.com/reconquest/shdoc).

# Routed by src/router.sh

cmd_bashdoc() {

if [[ "$1" == "bashdoc" ]]; then # Bashdoc

  if [[ ! -f Sherpa.yaml ]]; then
    p "Opps. Probably not in a project root."
    exit 1
  fi

  # Define directories
  SRC_DIR="src"
  DOCS_DIR="docs"
  HBS="${SDD}/templates/bashdoc.hbs"

  # Create docs directory if it doesn't exist
  [[ ! -d "$DOCS_DIR" ]] && mkdir -p "$DOCS_DIR"

  # Loop over all .sh files in the src directory
  for script in "$SRC_DIR"/*.sh; do
    # Check if there are any .sh files
    if [[ -f "$script" ]]; then
      # Extract the base name (filename without path)
      base_name=$(basename "$script" .sh)
      # Generate the markdown documentation using shdoc
      # shdoc < "$script" > "$DOCS_DIR/$base_name.md"
      bashdoc -c -j -l "${DOCS_DIR}" -t "${HBS}" $script
    fi
  done

fi # End Bashdoc
}
# @file Compile
# @brief Compiles the script to a binary, using SHC.
# @description
#
#    To be used from the root of a Sherpa project,
#    created with "sherpa new myProject".
#
#    It will:
#      * Complain if you didn't first run: sherpa make
#      * Create if needed the target/bin folder
#      * Replace the shebang by "#!/bin/bash" (env not supported)
#      * Compile the script using generated C code
#      * Use the name from Sherpa.yaml -> .package.executable field
#      * Save the binary in target/bin
#      * Refresh or Update the symlink to .sherpa/bin
#
#  Usage: sherpa compile
#

#                     #
#   --- Compile ---   #
#                     #

# Routed by src/router.sh

cmd_compile() {

	if [[ "$1" == "compile" ]]; then # Compile

		executable="$(get_yaml_item "package.executable" Sherpa.yaml)"
		# TODO: Do something if executable is empty
		script="target/local/${executable}"
		scriptCopy="/tmp/${executable}-copy"

		# Chack if the built script is here in target/local
		if [[ ! -f "target/local/${executable}" ]]; then # IsFile
			p "${btnWarning} Oops! ${x} Run first: ${em}sherpa build${x}"
			exit 1
		else

			# Create the directory if necessary
			[[ ! -d "target/bin" ]] && mkdir target/bin

			# Replace SheBang, as SHC does not support /usr/bin/env
			# will look for other solution later, eventually...
			cp "$script" "$scriptCopy"
			sed_inplace "$scriptCopy" 's|#!/usr/bin/env bash|#!/bin/bash|g'

			p "Compiling to Binary via SHC..."
			export CC=gcc
			shc -vrf "$scriptCopy" -o "target/bin/${executable}"

			# Check the success of the execution
			if [[ "$?" == 0 ]]; then
				br
				p "${btnSuccess} Done! ${x} The binary is stored in target/bin"
				# Remove the temporary file
				rm ${scriptCopy}
				br

				# The eventualy existing symlink
				symlink="${SDD}/bin/${executable}"

				# Get the target of the symlink
				target=$(readlink -f "$symlink")

				# Check if the target doesn't contain "target/bin"
				if [[ "$target" != *"target/bin"* ]]; then
					# Remove the existing symlink
					rm "$symlink"

					# Create a new symlink
					ln -s "$(pwd)/target/bin/${executable}" "${SDD}/bin/${executable}"

					echo "Symlink updated successfully."
				else
					echo "bin/${executable} still Symlinked to ${SDD}/bin"
				fi

			else
				br
				p "Ooops! Command failed, with the ${?} exit code."
				br
			fi

		fi # End IsFile
	fi  # End Compile
}
# --------------------------- #
#  Open main.sh in the Editor #
# --------------------------- #

# @file Edit
# @brief Open main files with the default Editor (conf in basecamp.sh).
# @description
#
#    To be used from the root of a Sherpa project,
#    created with "sherpa new myProject".
#
#    It will:
#      * Use the program set in basecamp.sh, default to Vim
#      * Open some pre-defined key files for quick editions
#
#    Routes:
#      * bin: src/bin.sh - Main entry to the script content
#      * opt: src/_options.sh - Flags and options via Getopt
#      * basecamp: ~/.sherpa/basecamp.sh - Globals & Conf
#      * yaml: Sherpa.yaml - Configuration variables
#
#    Arg $1 string The command, itself: e OR edit
#    Arg $2 string The file code name: bin, opt, basecamp...
#
#  Usage: sherpa e bin
#

# Routed by src/router.sh

cmd_edit() {

if [[ $1 == "edit" || $1 == "e" ]]; then # Edit

  fileToEdit=$2

  # Edit the src/bin.sh file
  if [[ "$fileToEdit" == "bin" ]]; then # Options
    if [[ -f "src/bin.sh" ]]; then
      ${EDITOR} src/bin.sh
    else
      br
      p "Oops. No src/bin.sh file from here."
      em "Make sure you are in a project root"
      br
    fi

  # Edit the src/_options.sh file
  elif [[ "$fileToEdit" == "opt" ]]; then
    if [[ -f "src/_options.sh" ]]; then
      ${EDITOR} src/_options.sh
    else
      br
      p "Oops. No src/_options.sh file from here."
      em "Make sure you are in a project root"
      br
    fi

  # Edit the src/_options.sh file
  elif [[ "$fileToEdit" == "basecamp" ]]; then
    if [[ -f "${SDD}/basecamp.sh" ]]; then
      ${EDITOR} "${SDD}/basecamp.sh"
    else
      br
      p "Oops. Can't reach the basecamp."
      em "Make sure Sherpa is corectly installed"
      br
    fi

  # Edit the Sherpa.yaml file
  elif [[ "$fileToEdit" == "yaml" ]]; then
    if [[ -f "Sherpa.yaml" ]]; then
      ${EDITOR} "Sherpa.yaml"
    else
      br
      p "Oops. Can't find the Sherpa.yaml file."
      em "Make sure you are in a project root"
      br
    fi

  fi # end Options
fi   # end Edit
}
# @file Box
# @brief Commands related to some Box Management
# @description
#
#    - localBox: details about a local BashBox
#    - rmBox : Removing a local BashBox
#    - upBox : Updating a remote BashBox
#

# ------------------------ #
#  Local BashBox Infos     #
# ------------------------ #

# Routed by src/router.sh: localBox, rmBox, rmLib, upLib

cmd_box() {

if [[ "$1" == "localBox" ]]; then # localBox

  # Like in ${SCD}/boxes/<boxName>
  boxName="$2"

  # Warning if Directory not found
  if [[ ! -d "${SCD}/boxes/${boxName}" ]]; then
    br
    p "There is no ${txtBlue}${boxName}${x} directory in boxes/"
    br

    exit 1
  fi

  # Data Variables
  yaml="${SCD}/boxes/${boxName}/Sherpa.yaml"
  exe="$(get_yaml_item "package.executable" "$yaml")"

  #
  #   --- Output ---
  #

  clear
  h1 " ${boxName}"
  hr "BashBox" "-"

  # Meta data
  # Add: description, author, licence, docs, repo
  p "- Root: ${SCD}/boxes/${boxName}"
  p "- Executable: ${em}${exe}${x}"
  br
  p "${txtDanger} Delete ${x} Usage: ${em}sherpa rmBox ${boxName}${x}"

fi # End localBox

# ------------------------ #
#  Delete a local BashBox  #
# ------------------------ #

if [[ "$1" == "rmBox" ]]; then # rmBox

  # Like in ${SCD}/boxes/<boxName>
  boxName="$2"

  # Warning if Directory not found
  if [[ ! -d "${SCD}/boxes/${boxName}" ]]; then
    br
    p "${btnWarning} Oops! ${x} There is no ${txtBlue}${boxName}${x} directory in boxes/"
    br

    exit 1
  fi

  # Data Variables
  root="${SCD}/boxes/${boxName}"
  exe="$(get_yaml_item "package.executable" "${root}/Sherpa.yaml")"
  link="${SDD}/bin/${exe}"
  localBoxes="${SCD}/registers/localBoxes.yaml"

  #
  #   --- Output ---
  #

  confirm "Do you really want to delete ${boxName}?"
  br
  h2 " Allright, let's clean a little..."
  br

  # Delete Symlink
  [[ -L "$link" ]] && rm "$HOME/.sherpa/bin/${exe}"
  p "- Removed symlink: ${em}${exe}${x}"

  # Delete root direcory
  rm -rf "$root"
  p "- Removed directory: ${em}${root}${x}"

  # Delete register entry
  remove_yaml_item "$boxName" "$localBoxes"
  p "- Removed register entry: ${em}${boxName}${x}"
  br

  p "${btnSuccess} Done! ${x} ${strong}${boxName}${x} just left the camp"
  br

  exit 0

fi # End rmBox

# ---------------------------- #
#  Delete a local BashBox Lib  #
# ---------------------------- #

if [[ "$1" == "rmLib" ]]; then # rmLib

  # Like in ${SCD}/boxes/<boxName>
  libName="$2"

  # Warning if Directory not found
  if [[ ! -d "${SCD}/lib/${libName}" ]]; then
    br
    p "${btnWarning} Oops! ${x} There is no ${txtBlue}${libName}${x} directory in lib/"
    br

    exit 1
  fi

  # Data Variables
  root="${SCD}/lib/${libName}"
  localLibs="${SCD}/registers/localLibs.yaml"

  #
  #   --- Output ---
  #

  confirm "Do you really want to delete ${libName}?"
  br
  h2 " Allright, let's clean a little..."
  br

  # Delete root direcory
  rm -rf "$root"
  p "- Removed directory: ${em}${root}${x}"

  # Delete register entry
  remove_yaml_item "$libName" "$localLibs"
  p "- Removed register entry: ${em}${libName}${x}"
  br

  p "${btnSuccess} Done! ${x} ${strong}${libName}${x} just left the camp"
  br

  exit 0

fi # End rmLib

# ---------------------------- #
#  Update a local BashBox Lib  #
# ---------------------------- #

if [[ "$1" == "upLib" ]]; then # upLib

  # Like in ${SCD}/lib/<libName>
  libName="$2"

  # Warning if Directory not found
  if [[ ! -d "${SCD}/lib/${libName}" ]]; then
    br
    p "${btnWarning} Oops! ${x} There is no ${txtBlue}${libName}${x} directory in lib/"
    br

    exit 1
  fi

  #
  #   --- Output ---
  #

  confirm "Do you want to update ${libName}?"

  br
  h2 " No problem, let's go..."
  br

  # Get inside
  p "- Moving into the Directory"
  cd "${SCD}/lib/${libName}" || return

  # Pull
  branch="$(git remote show origin | sed -n '/HEAD branch/s/.*: //p')"
  p "- Reset from origin/${branch}"
  br
  git fetch origin "$branch"

  if git reset --hard origin/"$branch"; then
    br
    p "${btnSuccess} Done! ${x} ${libName} is updated."
    br
  else
    br
    p "${btnWarning} Oops! ${x} Command exited with code ${?}"
    br
  fi

fi # End upLib
}
# @file UpBox
# @brief Update an installed (remote) BashBox
# @description
#
#	To be used from anywhere.
#
#	It will:
#	  * Move into ${SCD}/bbr/bin/<boxName>
#	  * Pull the latest content
#	  * Build the package again
#
#	The local rmBox/rmLib/upLib commands live in src/commands/box.sh.
#	This file used to carry a second, near-identical rmBox that
#	shadowed the one in box.sh, because the later file wins in the
#	concatenation. That duplicate is gone.
#
#  Usage: sherpa upBox <boxName>
#

# shellcheck disable=SC2154

cmd_upBox() {
	# Most of the time, the same as the directory name
	# in ${SCD}/bbr/bin/<boxName>
	boxName="${2:-}"

	if [[ -z "$boxName" ]]; then
		p "${btnWarning} Oops! ${x} Usage: ${em}sherpa upBox <boxName>${x}"
		exit 1
	fi

	# Check if it exists
	if [[ ! -d "${SCD}/bbr/bin/${boxName}" ]]; then
		br
		p "${btnWarning} Oops! ${x} There is no ${txtBlue}${boxName}${x} directory in bbr/bin/"
		br

		exit 1
	fi

	confirm "Do you want to update ${boxName}?"

	br
	p " No problem, let's go..."
	br

	# Get inside
	p "- Moving into the Directory"
	cd "${SCD}/bbr/bin/${boxName}" || return

	# Pull
	p "- Pulling latest content"
	git pull

	# Re-Build
	p "- Build again..."
	sherpa build
	br

	return 0
}
